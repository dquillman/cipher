# Normalize all text files to LF in the repo. Windows tools can still see CRLF locally.
* text=auto eol=lf

# Explicit binary types (no text conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.zip binary
*.xlsx binary
*.docx binary
