rules_version = '2';

// UNIFIED storage rules for the shared bucket exam-coach-ai-platform.
// Both Migraine Tracker and Cipher Exam deploy storage.rules to the SAME
// bucket, so the last deploy wins — this file must therefore cover BOTH apps'
// paths. Keep this in sync with Migraine Tracker's storage.rules (identical).
service firebase.storage {
  match /b/{bucket}/o {
    // Cipher Exam: per-user uploads.
    match /uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Migraine Tracker: bug-report attachments, scoped to the uploader.
    match /issues/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf|text/plain');
    }

    // Everything else: denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
