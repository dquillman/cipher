rules_version = '2';

// ============================================================================
// UNIFIED FIRESTORE RULES — Single source of truth for exam-coach-ai-platform
// Used by: Admin Core, Exam Coach (AdaptiGrowth), Migraine Tracker
// IMPORTANT: Only deploy rules from Admin-Core. All other projects should
// remove "firestore" from their firebase.json to prevent overwriting.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin')) ||
              isBootstrapUser();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBootstrapUser() {
      return isAuthenticated() && request.auth.token.email == 'dquillman2112@gmail.com';
    }

    // ===== USERS =====
    // Open read/write for auth'd users (guest/anon support)
    // Admin SDK (Cloud Functions) bypasses rules for privileged field writes

    match /users/{userId} {
      allow read, write: if isAuthenticated();

      // User subcollections (questionProgress, exam_attempts, etc.)
      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ===== APP-SCOPED COLLECTIONS (apps/{appId}/...) =====

    match /apps/{appId} {
      allow read: if true;

      match /config/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /sources/{docId} {
        allow read, write: if isAdmin();
      }

      match /audit/{docId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      }

      // App-scoped subscriptions (PUBLIC read for client apps + admin panel)
      match /subscriptions/{userId} {
        allow read: if true;
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Migraine Tracker: entries
      match /entries/{entryId} {
        allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // Migraine Tracker: user settings
      match /userSettings/{userId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // OnboardKit: Flows
      match /flows/{flowId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // OnboardKit: Sessions
      match /sessions/{sessionId} {
        allow read, write: if isAuthenticated();
      }

      // OnboardKit: Analytics
      match /analytics/{analyticsId} {
        allow read: if isAdmin();
        allow write: if true;
      }
    }

    // Belt + suspenders: top-level subscription read guarantee
    match /apps/{appId}/subscriptions/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ===== EXAM CONTENT (Public Read, Admin Write) =====

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /smart_questions/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /exam_sets/{setId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /exam_questions/{examId}/items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /exam_questions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===== STUDY PLANS =====

    match /study_plans/{planId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ===== QUIZ / EXAM ATTEMPTS =====

    match /quizAttempts/{attemptId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /exam_attempts/{userId}/{attemptId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /exam_attempts/{attemptId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Quiz Runs (nested under user)
    match /quizRuns/{userId}/runs/{runId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ===== USER MASTERY =====

    match /userMastery/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ===== USER SESSIONS =====

    match /user_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // ===== USAGE EVENTS (Client Write, Admin Read) =====

    match /usage_events/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // ===== ISSUES / BUG REPORTING =====

    match /issues/{issueId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /reported_issues/{issueId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /issue_categories/{categoryId} {
      allow read, write: if isAdmin();
    }

    match /release_versions/{versionId} {
      allow read, write: if isAdmin();
    }

    // ===== CONVERSION / FRICTION TRACKING =====

    match /conversion_events/{event} {
      allow read: if isAdmin();
    }

    match /conversion_intent/{eventId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    match /friction_events/{eventId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // ===== MARKETING (Public Read) =====

    match /marketing_assets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== TESTIMONIALS =====
    // One submission per user, captured at the activated_user (Q10) milestone.
    // Doc ID is the user's UID so duplicates are impossible.

    match /testimonials/{userId} {
      // Each user can write their own testimonial exactly once. The doc-doesn't-
      // exist check at create-time prevents a logged-in user from overwriting
      // a previous submission via curl or devtools.
      allow create: if isOwner(userId)
                    && !exists(/databases/$(database)/documents/testimonials/$(userId))
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ===== SYSTEM / APP CONFIG (Public Read, pre-auth) =====

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ===== ADMIN-ONLY COLLECTIONS =====

    match /admin_audit/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_metrics/{docId} {
      allow read, write: if isAdmin();
    }

    match /broadcast_drafts/{draftId} {
      allow read, write: if isAdmin();
    }

    match /weekly_reviews/{reviewId} {
      allow read, write: if isAdmin();
    }

    match /founder_briefings/{briefingId} {
      allow read, write: if isAdmin();
    }

    match /decisions/{decisionId} {
      allow read, write: if isAdmin();
    }

    match /simulations/{simId} {
      allow read, write: if isAdmin();
    }

    match /billing_events_unresolved/{eventId} {
      allow read: if isAdmin();
    }

    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    match /testers/{testerId} {
      allow read, write: if isAdmin();
    }

    match /examHealth/{docId} {
      allow read, write: if isAdmin();
    }

    match /system_metrics/{docId} {
      allow read, write: if isAdmin();
    }

    match /exam_update_sources/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_workflows/{userId}/{document=**} {
      allow read, write: if isAdmin();
    }

    match /admin_marketing_assets/{userId}/{document=**} {
      allow read, write: if isAdmin();
    }

    // ===== MARKETING COMMAND CENTER (Dave only) =====

    match /marketing_checklist/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_budget/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_funnel/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_ab_tests/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_content/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_users_first100/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_linkedin_outreach/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_reddit_communities/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_reddit_activity/{docId} {
      allow read, write: if isBootstrapUser();
    }

    match /marketing_reddit_drafts/{docId} {
      allow read, write: if isBootstrapUser();
    }

    // ===== DEFAULT DENY =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
