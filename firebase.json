{
    "storage": {
        "rules": "storage.rules"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ],
            "predeploy": [
                "npm --prefix \"$RESOURCE_DIR\" run build",
                "node \"$RESOURCE_DIR/scripts/check-email-config.mjs\""
            ]
        }
    ],
    "hosting": [
        {
            "target": "web",
            "public": "web/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/app/**",
                    "destination": "/_catchall.html"
                },
                {
                    "source": "**",
                    "destination": "/_catchall.html"
                }
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=0, must-revalidate"
                        },
                        {
                            "key": "Cross-Origin-Opener-Policy",
                            "value": "same-origin-allow-popups"
                        }
                    ]
                },
                {
                    "source": "**/*.@(js|css|jpg|jpeg|png|webp|svg|gif|woff|woff2)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "max-age=31536000"
                        }
                    ]
                }
            ]
        },
        {
            "target": "staging",
            "public": "web/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/app/**",
                    "destination": "/_catchall.html"
                },
                {
                    "source": "**",
                    "destination": "/_catchall.html"
                }
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=0, must-revalidate"
                        },
                        {
                            "key": "Cross-Origin-Opener-Policy",
                            "value": "same-origin-allow-popups"
                        }
                    ]
                },
                {
                    "source": "**/*.@(js|css|jpg|jpeg|png|webp|svg|gif|woff|woff2)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "max-age=31536000"
                        }
                    ]
                }
            ]
        },
        {
            "target": "production",
            "public": "web/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/app/**",
                    "destination": "/_catchall.html"
                },
                {
                    "source": "**",
                    "destination": "/_catchall.html"
                }
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=0, must-revalidate"
                        },
                        {
                            "key": "Cross-Origin-Opener-Policy",
                            "value": "same-origin-allow-popups"
                        }
                    ]
                },
                {
                    "source": "**/*.@(js|css|jpg|jpeg|png|webp|svg|gif|woff|woff2)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "max-age=31536000"
                        }
                    ]
                }
            ]
        }
    ],
    "emulators": {
        "auth": {
            "port": 9099
        },
        "functions": {
            "port": 5001
        },
        "ui": {
            "enabled": true
        }
    }
}
